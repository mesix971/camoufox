@@ -3100,6 +3108,18 @@ CanvasRenderingContext2D::ToDataURL(JSContext* aCx, const nsAString& aType,
     return nullptr;
   }

+  // CAMOUFOX: noise the raw bitmap BEFORE the JPEG/PNG encoder runs.
+  // Must match GetImageData so hash(toDataURL) and hash(getImageData)
