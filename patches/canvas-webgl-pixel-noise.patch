# New helper header — added to additions/ so the patch stays small.
diff --git a/additions/camoucfg/CamoufoxCanvasNoise.hpp b/additions/camoucfg/CamoufoxCanvasNoise.hpp
new file mode 100644
--- /dev/null
+++ b/additions/camoucfg/CamoufoxCanvasNoise.hpp
@@ -0,0 +1,73 @@
+// Camoufox: per-pixel noise helpers for 2D canvas + WebGL readback.
+// Header-only. Seeded PRNG is deterministic per (profile, buffer
+// content) so same profile + same frame = same hash; different profile
+// = different hash. This breaks WAFs that hash the pixel buffer while
+// keeping the canvas visually identical.
+#ifndef CAMOUFOX_CANVAS_NOISE_HPP
+#define CAMOUFOX_CANVAS_NOISE_HPP
+
+#include <algorithm>
+#include <cstdint>
+#include <cstddef>
+#include "MaskConfig.hpp"
+
+namespace camoufox {
+
+// LCG — fast, not crypto, deterministic.
+inline uint64_t lcg_step(uint64_t& state) {
+  state = state * 6364136223846793005ULL + 1442695040888963407ULL;
+  return state;
+}
+
+// Seed from: user-provided seed XOR first 64 bytes of the buffer.
+// Seeding on content means identical frame = identical hash (stable),
+// but changing one pixel changes the seed = new noise pattern.
+inline uint64_t content_seed(const uint8_t* data, size_t len, uint64_t key) {
+  uint64_t s = 0x9E3779B97F4A7C15ULL ^ key;
+  size_t probe = std::min<size_t>(len, 64);
+  for (size_t i = 0; i < probe; i += 4) {
+    s ^= (uint64_t)data[i] << ((i % 8) * 8);
+  }
+  return s;
+}
+
+inline void ApplyCanvasPixelNoise(uint8_t* pixels, size_t len, bool rgba) {
+  uint8_t amp = static_cast<uint8_t>(
+      MaskConfig::GetInt32("canvas:pixel_noise:amplitude").value_or(2));
+  double freq = MaskConfig::GetDouble("canvas:pixel_noise:frequency").value_or(0.05);
+  int32_t user_seed = MaskConfig::GetInt32("canvas:pixel_noise:seed").value_or(0);
+  if (amp == 0 || !pixels || len == 0) return;
+  amp = std::min<uint8_t>(amp, 10);
+  freq = std::clamp(freq, 0.0, 1.0);
+
+  uint64_t seed = content_seed(pixels, len, static_cast<uint64_t>(user_seed));
+  const size_t stride = rgba ? 4 : 3;
+  const uint64_t thr = (uint64_t)(freq * 65535.0);
+  for (size_t i = 0; i + stride <= len; i += stride) {
+    if ((lcg_step(seed) & 0xFFFF) >= thr) continue;
+    int8_t d = static_cast<int8_t>((lcg_step(seed) & ((amp << 1) - 1)) - amp);
+    pixels[i + 0] = std::clamp(int(pixels[i + 0]) + d, 0, 255);
+    pixels[i + 1] = std::clamp(int(pixels[i + 1]) + d, 0, 255);
+    pixels[i + 2] = std::clamp(int(pixels[i + 2]) + d, 0, 255);
+    // alpha (i+3) untouched — changing it shifts compositing mode.
+  }
+}
+
+inline void ApplyWebGLReadbackNoise(uint8_t* pixels, size_t len) {
+  uint8_t amp = static_cast<uint8_t>(
+      MaskConfig::GetInt32("webgl:readback_noise:amplitude").value_or(2));
+  int32_t user_seed = MaskConfig::GetInt32("webgl:readback_noise:seed").value_or(0);
+  if (amp == 0 || !pixels || len == 0) return;
+  amp = std::min<uint8_t>(amp, 10);
+  uint64_t seed = content_seed(pixels, len, static_cast<uint64_t>(user_seed) ^ 0xA5A5A5A5A5A5A5A5ULL);
+  for (size_t i = 0; i + 3 < len; i += 4) {
+    int8_t dr = static_cast<int8_t>((lcg_step(seed) & ((amp << 1) - 1)) - amp);
+    int8_t dg = static_cast<int8_t>((lcg_step(seed) & ((amp << 1) - 1)) - amp);
+    int8_t db = static_cast<int8_t>((lcg_step(seed) & ((amp << 1) - 1)) - amp);
+    pixels[i + 0] = std::clamp(int(pixels[i + 0]) + dr, 0, 255);
+    pixels[i + 1] = std::clamp(int(pixels[i + 1]) + dg, 0, 255);
+    pixels[i + 2] = std::clamp(int(pixels[i + 2]) + db, 0, 255);
+  }
+}
+
+}  // namespace camoufox
+#endif  // CAMOUFOX_CANVAS_NOISE_HPP
