+    size_t bmpLen = 0;
+    if (snapshot && GetSnapshotBytesRGBA(snapshot, &bmpData, &bmpLen) && bmpData) {
+      camoufox::ApplyCanvasPixelNoise(bmpData, bmpLen, /*rgba=*/true);
+    }
+  }
