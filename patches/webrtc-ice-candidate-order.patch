--- a/dom/media/webrtc/jsapi/PeerConnectionImpl.h
+++ b/dom/media/webrtc/jsapi/PeerConnectionImpl.h
@@ -700,6 +700,9 @@ class PeerConnectionImpl final : public nsISupports,
   RTCSignalingState mSignalingState{RTCSignalingState::Stable};
   RTCIceGatheringState mIceGatheringState{RTCIceGatheringState::New};
   RTCIceConnectionState mIceConnectionState{RTCIceConnectionState::New};
+
+  // CAMOUFOX: batched candidates awaiting post-processing + flush.
+  nsTArray<RefPtr<RTCIceCandidate>> mCamoufoxPendingCandidates;

