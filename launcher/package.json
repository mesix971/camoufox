{
  "name": "camoufox-launcher",
  "version": "0.2.0",
  "description": "Electron launcher for Camoufox — wraps fpgen, proxypool, and session management behind a UI.",
  "private": true,
  "homepage": "https://github.com/mesix971/camoufox",
  "author": {
    "name": "Camoufox",
    "email": "noreply@camoufox.local"
  },
  "main": "dist/main/main/index.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "esbuild src/renderer/index.tsx --bundle --outfile=dist/renderer/bundle.js --loader:.tsx=tsx --loader:.ts=ts --format=iife --target=es2022",
    "build:css": "tailwindcss -i src/renderer/styles.css -o dist/renderer/styles.css",
    "build:html": "node -e \"require('fs').mkdirSync('dist/renderer',{recursive:true});require('fs').copyFileSync('index.html','dist/renderer/index.html')\"",
    "build": "npm run build:main && npm run build:renderer && npm run build:css && npm run build:html",
    "watch:main": "tsc -p tsconfig.main.json --watch",
    "watch:renderer": "esbuild src/renderer/index.tsx --bundle --outfile=dist/renderer/bundle.js --loader:.tsx=tsx --loader:.ts=ts --format=iife --target=es2022 --watch",
    "watch:css": "tailwindcss -i src/renderer/styles.css -o dist/renderer/styles.css --watch",
    "dev": "npm run build:html && concurrently -k -n main,renderer,css,electron -c blue,green,magenta,yellow \"npm:watch:main\" \"npm:watch:renderer\" \"npm:watch:css\" \"wait-on dist/main/index.js dist/renderer/bundle.js dist/renderer/styles.css && electron .\"",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "package": "npm run build && electron-builder",
    "package:linux": "npm run build && electron-builder --linux AppImage deb",
    "package:win": "npm run build && electron-builder --win nsis portable",
    "package:mac": "npm run build && electron-builder --mac dmg zip",
    "package:all": "npm run build && electron-builder -mwl"
  },
  "build": {
    "appId": "com.camoufox.launcher",
    "productName": "Camoufox Launcher",
    "copyright": "Copyright © 2026 Camoufox",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "../fpgen",
        "to": "python/fpgen",
        "filter": [
          "**/*.py",
          "**/*.json",
          "!**/tests/**",
          "!**/__pycache__/**"
        ]
      },
      {
        "from": "../proxypool",
        "to": "python/proxypool",
        "filter": [
          "**/*.py",
          "!**/tests/**",
          "!**/__pycache__/**"
        ]
      },
      {
        "from": "../captchapool",
        "to": "python/captchapool",
        "filter": [
          "**/*.py",
          "!**/tests/**",
          "!**/__pycache__/**"
        ]
      },
      {
        "from": "../queuepool",
        "to": "python/queuepool",
        "filter": [
          "**/*.py",
          "!**/tests/**",
          "!**/__pycache__/**"
        ]
      },
      {
        "from": "../taskqueue",
        "to": "python/taskqueue",
        "filter": [
          "**/*.py",
          "!**/tests/**",
          "!**/__pycache__/**"
        ]
      },
      {
        "from": "../creepjsscore",
        "to": "python/creepjsscore",
        "filter": [
          "**/*.py",
          "!**/tests/**",
          "!**/__pycache__/**"
        ]
      },
      {
        "from": "../humanlike",
        "to": "python/humanlike",
        "filter": [
          "**/*.py",
          "!**/tests/**",
          "!**/__pycache__/**"
        ]
      },
      {
        "from": "../actions",
        "to": "python/actions",
        "filter": [
          "**/*.py",
          "!**/tests/**",
          "!**/__pycache__/**"
        ]
      },
      {
        "from": "./bridge",
        "to": "python/launcher/bridge",
        "filter": [
          "**/*.py",
          "!**/tests/**",
          "!**/__pycache__/**"
        ]
      },
      {
        "from": "./assets",
        "to": "assets"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "dist/main/**/*"
    ],
    "linux": {
      "category": "Network",
      "maintainer": "Camoufox <noreply@camoufox.local>",
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "synopsis": "Camoufox fingerprint-aware browser launcher"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "concurrently": "^9.0.1",
    "electron": "^32.1.2",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "wait-on": "^8.0.1"
  }
}
