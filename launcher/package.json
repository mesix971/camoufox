{
  "name": "camoufox-launcher",
  "version": "0.1.0",
  "description": "Electron launcher for Camoufox — wraps fpgen, proxypool, and session management behind a UI.",
  "private": true,
  "main": "dist/main/main/index.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "esbuild src/renderer/index.tsx --bundle --outfile=dist/renderer/bundle.js --loader:.tsx=tsx --loader:.ts=ts --format=iife --target=es2022",
    "build:css": "tailwindcss -i src/renderer/styles.css -o dist/renderer/styles.css",
    "build:html": "cp index.html dist/renderer/index.html",
    "build": "npm run build:main && npm run build:renderer && npm run build:css && npm run build:html",
    "watch:main": "tsc -p tsconfig.main.json --watch",
    "watch:renderer": "esbuild src/renderer/index.tsx --bundle --outfile=dist/renderer/bundle.js --loader:.tsx=tsx --loader:.ts=ts --format=iife --target=es2022 --watch",
    "watch:css": "tailwindcss -i src/renderer/styles.css -o dist/renderer/styles.css --watch",
    "dev": "npm run build:html && concurrently -k -n main,renderer,css,electron -c blue,green,magenta,yellow \"npm:watch:main\" \"npm:watch:renderer\" \"npm:watch:css\" \"wait-on dist/main/index.js dist/renderer/bundle.js dist/renderer/styles.css && electron .\"",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "concurrently": "^9.0.1",
    "electron": "^32.1.2",
    "esbuild": "^0.24.0",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "wait-on": "^8.0.1"
  }
}
